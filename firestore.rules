rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives & Global Helpers
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Auth token verification
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email in ['gamuragalaxy@gmail.com', 'selvaranjancg@gmail.com'])
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Entity Validations (Pillar 2: Validation Blueprints)
    function isValidUser(data) {
      return data.uid is string && (data.uid == request.auth.uid)
        && (data.nickname is string)
        && (data.createdAt is timestamp || data.createdAt is number);
    }

    function isValidSharedProject(data) {
      return data.userId is string && (data.userId == request.auth.uid)
        && (data.userName is string)
        && (data.title is string)
        && (data.timestamp is timestamp || data.timestamp is number);
    }

    function isValidChat(data, userId) {
      return data.userId is string && (data.userId == userId)
        && (data.title is string)
        && (data.messages is list)
        && (data.timestamp is number || data.timestamp is timestamp);
    }

    function isValidActivity(data) {
      return data.userId is string && (data.userId == request.auth.uid)
        && (data.title is string);
    }

    function isValidNeuralProfile(data) {
      return data.uid is string && (data.uid == request.auth.uid)
        && (data.nickname is string)
        && (!('lastPulse' in data) || data.lastPulse is timestamp || data.lastPulse is number || data.lastPulse == request.time);
    }

    function isValidNeuralChat(data) {
      return data.members is list && (request.auth.uid in data.members)
        && (data.timestamp is timestamp || data.timestamp is number || data.timestamp == request.time);
    }

    function isValidNeuralMessage(data) {
      return (data.senderId == request.auth.uid || data.senderId == 'ai_system')
        && (data.text is string)
        && (data.timestamp is timestamp || data.timestamp is number || data.timestamp == request.time);
    }

    function isValidGamuraDeveloper(data) {
      return data.username is string && data.username.size() > 0 && data.username.size() <= 128
        && (!('email' in data) || data.email is string)
        && (!('blocks' in data) || data.blocks is list)
        && (!('published' in data) || data.published is bool)
        && (!('plan' in data) || data.plan is string)
        && (!('clicks' in data) || data.clicks is number)
        && (!('views' in data) || data.views is number)
        && (!('visitors' in data) || data.visitors is number)
        && (!('engagements' in data) || data.engagements is number)
        && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is number || data.updatedAt == request.time);
    }

    // Phase 4: Match Blocks
    match /users/{userId} {
      // Identity Integrity (Pillar 3 & 4)
      allow read: if isSignedIn(); // Allow reading other users for Recent Users list
      allow list: if isSignedIn(); // Allow listing users for Recent Users list
      
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());

      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming());
      
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin() || (resource != null && resource.data.uid == request.auth.uid));

      // Sub-collection: Chats (Pillar 1: Master Gate)
      match /chats/{chatId} {
        allow read, list: if isSignedIn() && request.auth.uid == userId;
        
        allow create: if isSignedIn() && isValidId(chatId) && request.auth.uid == userId
          && isValidChat(incoming(), userId)
          && incoming().keys().size() <= 6; // userId, title, messages, timestamp, id?

        allow update: if isSignedIn() && request.auth.uid == userId
          && isValidChat(incoming(), userId)
          && (
            // Action: Edit Chat or Append Messages
            (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'messages', 'timestamp']))
          );
        
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      // Sub-collection: Notifications (Pillar 1: Master Gate)
      match /notifications/{notifId} {
        allow read, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn();
        allow update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Test connection match
    match /test/connection {
      allow read: if true;
    }

    // System Stats (Global counter)
    match /system/stats {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /system_configs/{configId} {
      allow read: if isSignedIn() || true; // Allow read even if not signed in for global config if needed, or stick to isSignedIn()
      allow write: if isSignedIn();
    }

    // Bubu Progress
    match /system/bubu_progress {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // User Connections
    match /user_connections/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Activities
    match /activities/{activityId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(activityId) && isValidActivity(incoming());
    }

    // Username reservation
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/usernames/$(username)) && incoming().uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource != null && (resource.data.uid == request.auth.uid || isAdmin()));
    }

    // Shared Projects
    match /shared_projects/{projectId} {
      allow read, list: if true; // Publicly viewable
      allow create: if isSignedIn() && isValidId(projectId)
        && isValidSharedProject(incoming());
      allow update: if isSignedIn() && (
        (existing().userId == request.auth.uid
          && isValidSharedProject(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'link', 'image', 'timestamp', 'userName', 'userId', 'likes', 'comments']))
        || incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'comments'])
      );
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Neural Link
    match /neural_profiles/{nickname} {
      allow read, list: if true;
      allow create: if isSignedIn() && isValidNeuralProfile(incoming()) && incoming().nickname == nickname;
      allow update: if isSignedIn() && existing().uid == request.auth.uid && isValidNeuralProfile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['avatarUrl', 'uid', 'nickname', 'lastPulse']);
      allow delete: if isSignedIn() && (resource != null && (resource.data.uid == request.auth.uid || isAdmin()));
    }

    match /neural_requests/{requestId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == incoming().senderUid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.receiverUid || request.auth.uid == resource.data.senderUid);
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderUid || request.auth.uid == resource.data.receiverUid || isAdmin());
    }

    match /neural_connections/{connectionId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid in incoming().uids);
      allow delete: if isSignedIn() && ((request.auth.uid in resource.data.uids) || isAdmin());
    }

    match /neural_chats/{chatId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();

      match /messages/{msgId} {
        allow read, list, write: if isSignedIn();
      }
    }

    // Features
    match /features/{featureId} {
      allow read, list: if true;
      allow write: if isSignedIn(); // Allow seeding/managing features
    }

    // Gamura Developers Hub Match Block
    match /gamura_developers/{username} {
      allow read, list: if true;
      allow create: if isSignedIn() && isValidId(username) && isValidGamuraDeveloper(incoming()) 
        && (incoming().username == username || incoming().uid == request.auth.uid);
      allow update: if isSignedIn() && isValidGamuraDeveloper(incoming()) && (
        isAdmin() || 
        (resource.data.uid == request.auth.uid) ||
        (resource.data.email == request.auth.token.email) ||
        (exists(/databases/$(database)/documents/usernames/$(username)) && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid) ||
        (incoming().uid == request.auth.uid)
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (resource != null && (
          (request.auth.uid == username) ||
          ( 'uid' in resource.data && resource.data.uid == request.auth.uid ) ||
          resource.data.email == request.auth.token.email ||
          (exists(/databases/$(database)/documents/usernames/$(username)) && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid)
        ))
      );
    }

    // User Streaks Matrix
    match /user_streaks/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Gamura Short Links
    match /gamura_shortlinks/{linkId} {
      allow read, list: if true;
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow update: if (isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin())) || (incoming().diff(existing()).affectedKeys().hasOnly(['clicks']));
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Operational Broadcasts
    match /broadcasts/{broadcastId} {
      allow read, list: if true;
      allow write: if isSignedIn();
    }

    // Activity Logs
    match /activityLogs/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      match /logs/{logId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Analytics
    match /analytics/{doc=**} {
      allow read, list: if true;
      allow write: if isSignedIn();
    }

    // Gamura Clip (6-character capability room sync with strict schema & size guards; room listing disallowed)
    function isValidClipRoomCode(code) {
      return code is string && code.size() == 6 && code.matches('^[A-Z0-9]{6}$');
    }

    function isValidClipItem(data) {
      return data.keys().hasAll(['t', 'v', 'ts', 'exp', 'pin', 'from'])
        && data.keys().hasOnly(['t', 'v', 'iv', 'n', 's', 'ts', 'exp', 'pin', 'from'])
        && data.t in ['text', 'link', 'image', 'file', 'enc']
        && data.v is string && data.v.size() <= 920000
        && data.from is string && data.from.size() > 0 && data.from.size() <= 32
        && data.ts is number && data.exp is number && data.pin is bool
        && (!('iv' in data) || (data.iv is string && data.iv.size() <= 64))
        && (!('n' in data) || (data.n is string && data.n.size() <= 200))
        && (!('s' in data) || data.s is number);
    }

    function isValidClipPresence(data) {
      return data.keys().hasAll(['ts', 'n'])
        && data.keys().hasOnly(['ts', 'n'])
        && data.ts is number
        && data.n is string && data.n.size() > 0 && data.n.size() <= 32;
    }

    match /clip_rooms/{roomCode} {
      allow read, list, write: if false;

      match /items/{itemId} {
        allow get, list: if isValidClipRoomCode(roomCode);
        allow create: if isValidClipRoomCode(roomCode) && isValidId(itemId) && isValidClipItem(incoming());
        allow update: if isValidClipRoomCode(roomCode) && isValidId(itemId)
          && isValidClipItem(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['pin']);
        allow delete: if isValidClipRoomCode(roomCode) && isValidId(itemId);
      }

      match /presence/{deviceId} {
        allow get, list: if isValidClipRoomCode(roomCode);
        allow create, update: if isValidClipRoomCode(roomCode) && isValidId(deviceId) && isValidClipPresence(incoming());
        allow delete: if isValidClipRoomCode(roomCode) && isValidId(deviceId);
      }
    }

    // Gamura Launch Store: Community Star Ratings & Reviews (Public social proof, owner-restricted writes)
    function isValidStoreReview(data) {
      return data.keys().hasAll(['appId', 'userId', 'authorName', 'rating', 'comment', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['appId', 'userId', 'authorName', 'authorPhoto', 'rating', 'comment', 'createdAt', 'updatedAt'])
        && isValidId(data.appId) && data.appId.size() <= 80
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && (!('authorPhoto' in data) || (data.authorPhoto is string && data.authorPhoto.size() <= 500))
        && (data.rating is int || data.rating is number) && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 600
        && (data.createdAt is timestamp)
        && (data.updatedAt is timestamp);
    }

    match /store_reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if resource.data.rating >= 1 && resource.data.rating <= 5;
      allow create: if isSignedIn()
        && isValidId(reviewId)
        && isValidStoreReview(incoming())
        && reviewId == (incoming().appId + '__' + request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(reviewId)
        && (existing().userId == request.auth.uid || isAdmin())
        && isValidStoreReview(incoming())
        && incoming().userId == existing().userId
        && incoming().appId == existing().appId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['authorName', 'authorPhoto', 'rating', 'comment', 'updatedAt']);
      allow delete: if isSignedIn()
        && isValidId(reviewId)
        && (existing().userId == request.auth.uid || isAdmin());
    }

    // Gamura Launch Store: Cross-Device Cloud Sync for Installed Apps (Strict owner-only access)
    function isValidUserInstalledApps(data, userId) {
      return data.keys().hasAll(['uid', 'universeAppIds', 'mobileAppIds', 'customApps', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'gamuraHandle', 'universeAppIds', 'mobileAppIds', 'customApps', 'lastDevice', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && data.uid.size() <= 128
        && (!('gamuraHandle' in data) || (data.gamuraHandle is string && data.gamuraHandle.size() <= 80))
        && (!('lastDevice' in data) || (data.lastDevice is string && data.lastDevice.size() <= 64))
        && data.universeAppIds is list && data.universeAppIds.size() <= 100
        && (data.universeAppIds.size() == 0 || data.universeAppIds[0] is string)
        && data.mobileAppIds is list && data.mobileAppIds.size() <= 100
        && (data.mobileAppIds.size() == 0 || data.mobileAppIds[0] is string)
        && data.customApps is list && data.customApps.size() <= 30
        && (data.customApps.size() == 0 || data.customApps[0] is map)
        && (data.updatedAt is timestamp);
    }

    match /user_installed_apps/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserInstalledApps(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin())
        && isValidUserInstalledApps(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['gamuraHandle', 'universeAppIds', 'mobileAppIds', 'customApps', 'lastDevice', 'updatedAt']);
      allow delete: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin());
    }

    // Gamura Card (Gcard) <-> Gwallet (Gamura Wallet) Real-Time Sync Vault (Strict owner-only access)
    function isValidCardWalletVault(data, userId) {
      return data.keys().hasAll(['uid', 'connected', 'connectedAtMs', 'cardJson', 'walletJson', 'updatedByApp', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'connected', 'connectedAtMs', 'cardJson', 'walletJson', 'updatedByApp', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.connected is bool
        && (data.connectedAtMs is int || data.connectedAtMs is number) && data.connectedAtMs >= 0
        && data.cardJson is string && data.cardJson.size() <= 600000
        && data.walletJson is string && data.walletJson.size() <= 250000
        && data.updatedByApp in ['gcard', 'gwallet']
        && (data.updatedAt is timestamp);
    }

    match /card_wallet_vaults/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidCardWalletVault(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin())
        && isValidCardWalletVault(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['connected', 'connectedAtMs', 'cardJson', 'walletJson', 'updatedByApp', 'updatedAt']);
      allow delete: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin());
    }

    // Gamura Card <-> Gwallet Cross-Device QR Pairing Channel (Unguessable capability token, listing disallowed)
    function isValidPairCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 10 && code.matches('^[A-Z0-9]{6,10}$');
    }

    function isValidCardWalletPairing(data, pairCode) {
      return data.keys().hasAll(['pairCode', 'connected', 'peerConnected', 'initiatorApp', 'cardJson', 'walletJson', 'updatedByApp', 'updatedAt'])
        && data.keys().hasOnly(['pairCode', 'connected', 'peerConnected', 'initiatorApp', 'cardJson', 'walletJson', 'updatedByApp', 'updatedAt'])
        && data.pairCode is string && data.pairCode == pairCode
        && data.connected is bool
        && data.peerConnected is bool
        && data.initiatorApp in ['gcard', 'gwallet']
        && data.cardJson is string && data.cardJson.size() <= 600000
        && data.walletJson is string && data.walletJson.size() <= 250000
        && data.updatedByApp in ['gcard', 'gwallet']
        && (data.updatedAt is timestamp);
    }

    match /card_wallet_pairings/{pairCode} {
      allow get: if isValidPairCode(pairCode);
      allow list: if false;
      allow create: if isValidPairCode(pairCode)
        && isValidCardWalletPairing(incoming(), pairCode)
        && incoming().updatedAt == request.time;
      allow update: if isValidPairCode(pairCode)
        && isValidCardWalletPairing(incoming(), pairCode)
        && incoming().pairCode == existing().pairCode
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['connected', 'peerConnected', 'initiatorApp', 'cardJson', 'walletJson', 'updatedByApp', 'updatedAt']);
      allow delete: if isValidPairCode(pairCode);
    }

    // Gamura Software License, Terms of Service & Privacy Consent (Strict owner-only access)
    function isValidUserLicense(data, userId) {
      return data.keys().hasAll(['uid', 'status', 'version', 'platform', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'status', 'version', 'platform', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.status in ['agreed', 'declined']
        && data.version is string && data.version.size() >= 1 && data.version.size() <= 20
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 24
        && (data.updatedAt is timestamp);
    }

    match /user_licenses/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserLicense(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin())
        && isValidUserLicense(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'version', 'platform', 'updatedAt']);
      allow delete: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin());
    }
  }
}
