{
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|\\.well-known/|favicon|manifest|selvaranjan_gamura\\.html|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
