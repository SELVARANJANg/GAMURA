{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "nickname": { "type": "string" },
        "username": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "universePreferences": { "type": "object" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "nickname", "createdAt"]
    },
    "SharedProject": {
      "title": "SharedProject",
      "description": "Project shared by a user",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "link": { "type": "string" },
        "image": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["title", "link", "userId", "userName", "timestamp"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A conversation with AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "messages": { 
          "type": "array",
          "items": { "type": "object" }
        },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "title", "messages", "timestamp"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Global system activity",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "ic": { "type": "string" },
        "timestamp": { "type": "object" },
        "user": { "type": "string" },
        "userId": { "type": "string" },
        "priority": { "type": "string" },
        "dueDate": { "type": "string" }
      }
    },
    "NeuralProfile": {
      "title": "NeuralProfile",
      "description": "Unique nickname for Neural Link",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nickname": { "type": "string" },
        "avatarUrl": { "type": "string" }
      },
      "required": ["uid", "nickname"]
    },
    "NeuralChat": {
      "title": "NeuralChat",
      "description": "Ephemeral group or 1:1 chat",
      "type": "object",
      "properties": {
        "members": { "type": "array", "items": { "type": "string" } },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "createdBy": { "type": "string" },
        "timestamp": { "type": "object" }
      }
    },
    "NeuralMessage": {
      "title": "NeuralMessage",
      "description": "Temporary message",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "object" }
      }
    },
    "Feature": {
      "title": "Feature",
      "description": "Feature tracking entry",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" },
        "progress": { "type": "number" },
        "color": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "GamuraDeveloper": {
      "title": "GamuraDeveloper",
      "description": "Gamura Developer claimed hubs and metrics",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "blocks": { "type": "array", "items": { "type": "object" } },
        "published": { "type": "boolean" },
        "plan": { "type": "string" },
        "clicks": { "type": "number" },
        "views": { "type": "number" },
        "visitors": { "type": "number" },
        "engagements": { "type": "number" },
        "updatedAt": { "type": "object" }
      },
      "required": ["username"]
    },
    "UserStreak": {
      "title": "UserStreak",
      "description": "Daily login streak tracking and points",
      "type": "object",
      "properties": {
        "streakCount": { "type": "number" },
        "points": { "type": "number" },
        "claimedToday": { "type": "boolean" },
        "lastLogin": { "type": "string" },
        "badges": { "type": "array", "items": { "type": "string" } }
      }
    },
    "GamuraShortLink": {
      "title": "GamuraShortLink",
      "description": "Short links routing table",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "url": { "type": "string" },
        "uid": { "type": "string" },
        "clicks": { "type": "number" },
        "createdAt": { "type": "object" }
      },
      "required": ["slug", "url", "uid"]
    },
    "Broadcast": {
      "title": "Broadcast",
      "description": "Operational broadcasts and system notices",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "object" }
      }
    },
    "ClipRoomItem": {
      "title": "ClipRoomItem",
      "description": "Cross-device clipboard item in a Gamura Clip room",
      "type": "object",
      "properties": {
        "t": { "type": "string", "enum": ["text", "link", "image", "file", "enc"] },
        "v": { "type": "string", "maxLength": 920000 },
        "iv": { "type": "string", "maxLength": 64 },
        "n": { "type": "string", "maxLength": 200 },
        "s": { "type": "number" },
        "ts": { "type": "number" },
        "exp": { "type": "number" },
        "pin": { "type": "boolean" },
        "from": { "type": "string", "maxLength": 32 }
      },
      "required": ["t", "v", "ts", "exp", "pin", "from"]
    },
    "ClipRoomPresence": {
      "title": "ClipRoomPresence",
      "description": "Active device presence heartbeat in a Gamura Clip room",
      "type": "object",
      "properties": {
        "ts": { "type": "number" },
        "n": { "type": "string", "maxLength": 32 }
      },
      "required": ["ts", "n"]
    },
    "StoreAppReview": {
      "title": "StoreAppReview",
      "description": "Community star rating and review for a Gamura Launch Store application",
      "type": "object",
      "properties": {
        "appId": { "type": "string", "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 60 },
        "authorPhoto": { "type": "string", "maxLength": 500 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["appId", "userId", "authorName", "rating", "comment", "createdAt", "updatedAt"]
    },
    "UserInstalledApps": {
      "title": "UserInstalledApps",
      "description": "Cross-device cloud-synced installed Launch Store apps for a Gamura ID user",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "gamuraHandle": { "type": "string", "maxLength": 80 },
        "universeAppIds": { "type": "array" },
        "mobileAppIds": { "type": "array" },
        "customApps": { "type": "array" },
        "lastDevice": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "object" }
      },
      "required": ["uid", "universeAppIds", "mobileAppIds", "customApps", "updatedAt"]
    },
    "CardWalletVault": {
      "title": "CardWalletVault",
      "description": "Real-time bidirectional synced state between Gamura Card (Gcard) and Gwallet (Gamura Wallet) per user",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "connected": { "type": "boolean" },
        "connectedAtMs": { "type": "number" },
        "cardJson": { "type": "string", "maxLength": 600000 },
        "walletJson": { "type": "string", "maxLength": 250000 },
        "updatedByApp": { "type": "string", "enum": ["gcard", "gwallet"] },
        "updatedAt": { "type": "object" }
      },
      "required": ["uid", "connected", "connectedAtMs", "cardJson", "walletJson", "updatedByApp", "updatedAt"]
    }
  },
  "firestore": {
    "/user_streaks/{userId}": {
      "schema": { "$ref": "#/entities/UserStreak" },
      "description": "Store user streaks and achievements"
    },
    "/gamura_shortlinks/{linkId}": {
      "schema": { "$ref": "#/entities/GamuraShortLink" },
      "description": "Store shortlinks with click tracking"
    },
    "/broadcasts/{broadcastId}": {
      "schema": { "$ref": "#/entities/Broadcast" },
      "description": "Operational broadcast announcements"
    },
    "/gamura_developers/{username}": {
      "schema": { "$ref": "#/entities/GamuraDeveloper" },
      "description": "Store developer accounts and public urls"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Store user profiles"
    },
    "/neural_profiles/{nickname}": {
      "schema": { "$ref": "#/entities/NeuralProfile" },
      "description": "Lookup users by unique nickname"
    },
    "/neural_chats/{chatId}": {
      "schema": { "$ref": "#/entities/NeuralChat" },
      "description": "Group and 1:1 chats"
    },
    "/neural_chats/{chatId}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/NeuralMessage" },
      "description": "Ephemeral messages"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Store chats belonging to user"
    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/Activity" },
      "description": "Global system activities"
    },
    "/features/{featureName}": {
      "schema": { "$ref": "#/entities/Feature" },
      "description": "Platform feature tracker"
    },
    "/shared_projects/{projectId}": {
      "schema": { "$ref": "#/entities/SharedProject" },
      "description": "Store shared universe projects"
    },
    "/system/stats": {
      "schema": "object",
      "description": "Global system statistics"
    },
    "/clip_rooms/{roomCode}/items/{itemId}": {
      "schema": { "$ref": "#/entities/ClipRoomItem" },
      "description": "Cross-device shared clipboard items inside a 6-character room"
    },
    "/clip_rooms/{roomCode}/presence/{deviceId}": {
      "schema": { "$ref": "#/entities/ClipRoomPresence" },
      "description": "Active device presence heartbeats inside a 6-character clip room"
    },
    "/store_reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/StoreAppReview" },
      "description": "Public star ratings and community reviews for Gamura Launch Store apps"
    },
    "/user_installed_apps/{userId}": {
      "schema": { "$ref": "#/entities/UserInstalledApps" },
      "description": "Private cloud-synced installed app libraries keyed by Gamura ID user UID"
    },
    "/card_wallet_vaults/{userId}": {
      "schema": { "$ref": "#/entities/CardWalletVault" },
      "description": "Private real-time synchronized Gamura Card (Gcard) and Gwallet (Gamura Wallet) data per user"
    }
  }
}
